MONGODB_URI=
MONGODB_DB_NAME=
MONGODB_MAX_POOL_SIZE=10
CHAT_MESSAGE_TTL_SECONDS=15552000

STORAGE_DRIVER=local
# Only when STORAGE_DRIVER=r2 (Cloudflare R2, private bucket)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Signed photo links last this long (seconds)
R2_URL_TTL_SECONDS=3600
SCAN_RETENTION_DAYS=90
MAX_UPLOAD_BYTES=8388608

NODE_ENV=development
PORT=4000

# generate each secret with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN_SHORT=1d

APP_SCHEME=nutrifitai

#Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-ngrok-generated-url.ngrok/api/auth/google/callback
OAUTH_EXCHANGE_SECRET=

APP_REDIRECT_URIS=your-app-name://google-auth,http://localhost:8081/google-auth

# ngrok backend
EXPO_PUBLIC_API_URL=https://your-ngrok-generated-url


# OTP
OTP_LENGTH=4
OTP_TTL_MINUTES=10
OTP_MAX_FAILED_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Password reset authorization token (returned after OTP verify)
RESET_TOKEN_SECRET=change-me-reset
RESET_TOKEN_EXPIRES_IN=15m

# Mailer (for otp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="your-account-name <no-reply@your-account.app>"

# Cookies
# COOKIE_DOMAIN=localhost
CORS_ORIGIN=http://localhost:8081

# can be set with other models if configured
AI_CHAIN=ollama,groq,cerebras

AI_HISTORY_TURNS=10
AI_MAX_OUTPUT_TOKENS=700
AI_REQUEST_TIMEOUT_MS=30000

# ollama pull llama3.2:3b
OLLAMA_BASE_URL=your-ollama-base-url
OLLAMA_MODEL=your-ollama-model

OLLAMA_TIMEOUT_MS=120000
# Your PC's Ollama through ngrok: OLLAMA_BASE_URL=https://<your-ngrok-domain>/v1
OLLAMA_BASIC_AUTH=

# Groq free tier, used while the PC is off (AI_CHAIN=ollama,groq).
# Key and model id from console.groq.com; GROQ_BASE_URL is preset
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_MS=30000
GROQ_MAX_OUTPUT_TOKENS=450

# Cerebras free tier, tried after Groq (AI_CHAIN=ollama,groq,cerebras).
# Key and model id from cloud.cerebras.ai; CEREBRAS_BASE_URL is preset
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_TIMEOUT_MS=30000
CEREBRAS_MAX_OUTPUT_TOKENS=450

# ngrok authtoken1
your-ngrok-authtoken-for-frontend
# ngrok authtoken2
your-ngrok-authtoken-forbackend