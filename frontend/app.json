{
  "expo": {
    "name": "NutriFitAI",
    "slug": "nutrifitai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutrifitai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nutrifitai.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSMotionUsageDescription": "NutriFitAI reads your step count so it can track your daily activity against your goals.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nutrifitai.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.health.READ_STEPS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nutrifit-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dcffca",
          "image": "./assets/images/nutrifit-logo.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "NutriFitAI uses your camera to scan food and estimate its nutrition.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriFitAI uses your photos so you can scan food and set a profile picture.",
          "cameraPermission": "NutriFitAI uses your camera to scan food and estimate its nutrition.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#4caf1f"
        }
      ],
      "expo-web-browser",
      [
        "react-native-health-connect",
        {
          "permissions": [
            "android.permission.health.READ_STEPS"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3b71476-07f7-4db8-8c2e-4ac74bdacf5e"
      }
    },
    "owner": "nutrifitaiai"
  }
}
